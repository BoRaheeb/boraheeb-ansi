# BoRaheeb ANSI - Git attributes
# Follows the BoRaheeb Deployment Framework (BDF) docs/GIT_WORKFLOW.md section
# 6.2. Text files are LF in the repository and in the working tree, consistent
# with .editorconfig.
* text=auto eol=lf

# Text
*.java text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.properties text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.svg text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
LICENSE text eol=lf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.ttf binary
*.woff binary
*.woff2 binary
*.jar binary
*.zip binary
*.gz binary

# Third-party font license and attribution files are preserved byte for byte.
**/resources/fonts/*.txt -text
